# Banco de dados (interno ao container) — todas obrigatórias, sem valor padrão.
# Escolha DB_USERNAME/DB_PASSWORD/DB_NAME próprios; não reutilize os deste exemplo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# true apenas em desenvolvimento (sincroniza o schema automaticamente); nunca usar em produção
DB_SYNCHRONIZE=true

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=7d

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@seudominio.com

# URL pública usada nos links dos emails (confirmação de conta e convites)
WEB_BASE_URL=http://localhost:5000
